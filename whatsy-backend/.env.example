# Copy to .env and fill in your values

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/whatsy?sslmode=disable

# Zernio API credentials (from https://zernio.com/dashboard/settings/api)
ZERNIO_API_KEY=sk_your_64_hex_chars_here
ZERNIO_WEBHOOK_SECRET=your_webhook_secret_here

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# Server port (default: 8080)
PORT=8080
